<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".JEFE.JefeAulas.CrearAula.CrearAula">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Crear Aula"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/labelNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre del aula:"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp" />

    <EditText
        android:id="@+id/edtNombreAula"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Ej. Aula 101"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/labelNombre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/labelEncargado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecciona el encargado:"
        app:layout_constraintTop_toBottomOf="@id/edtNombreAula"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <Spinner
        android:id="@+id/spinnerEncargados"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/labelEncargado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <Button
        android:id="@+id/btnAddAula"
        style="@style/Widget.Material3.Button.ElevatedButton.Icon"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Crear Aula"
        app:icon="@drawable/add_24"
        app:layout_constraintTop_toBottomOf="@id/spinnerEncargados"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnCancelarAula"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="32dp" />

    <Button
        android:id="@+id/btnCancelarAula"
        style="@style/Widget.Material3.Button.ElevatedButton.Icon"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Cancelar"
        app:icon="@drawable/cancel_24"
        app:layout_constraintTop_toBottomOf="@id/spinnerEncargados"
        app:layout_constraintStart_toEndOf="@id/btnAddAula"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="32dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
